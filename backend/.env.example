PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 로컬 MVP는 비워두면 파일형 H2 DB를 사용합니다.
# Supabase/PostgreSQL 연결 시 아래 값을 설정하세요.
DATABASE_URL=jdbc:postgresql://localhost:5432/findependence
DATABASE_USERNAME=findependence
DATABASE_PASSWORD=change-me
DATABASE_DRIVER=org.postgresql.Driver

# Gemini API를 사용
LLM_ENABLED=true
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2

# RAG JSONL을 합친 후 켭니다.
RAG_ENABLED=false
RAG_DATA_PATH=../data/processed/housing_rag_final.jsonl
RAG_MAX_RESULTS=4
