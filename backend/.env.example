PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 로컬 MVP는 비워두면 파일형 H2 DB를 사용합니다.
# Supabase/PostgreSQL 연결 시 아래 값을 설정하세요.
DATABASE_URL=jdbc:postgresql://localhost:5432/findependence
DATABASE_USERNAME=findependence
DATABASE_PASSWORD=change-me
DATABASE_DRIVER=org.postgresql.Driver

# LM Studio의 Local Server를 사용할 때
LLM_ENABLED=true
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=
LLM_MODEL=phi-4-mini-instruct
LLM_TEMPERATURE=0.2

# RAG JSONL을 합친 후 켭니다.
RAG_ENABLED=false
RAG_DATA_PATH=../data/processed/housing_rag_final.jsonl
RAG_MAX_RESULTS=4
