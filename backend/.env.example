PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local-only defaults. Production: HTTPS, SPRING_PROFILES_ACTIVE=prod, random JWT_SECRET (32+ bytes).
JWT_SECRET=
JWT_ALLOW_EPHEMERAL_KEY=true
AUTH_COOKIE_SECURE=false
JWT_TTL_MINUTES=30

# 필요할 때 로컬 .env에만 관리자 정보를 입력하세요. 실제 값은 Git에 올리지 않습니다.
ADMIN_SEED_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=관리자

# 로컬과 팀 개발 모두 MySQL 8.x를 사용합니다.
DATABASE_URL=jdbc:mysql://127.0.0.1:3307/findependence?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false
DATABASE_USERNAME=findependence
DATABASE_PASSWORD=findependence-local
DATABASE_DRIVER=com.mysql.cj.jdbc.Driver

# Gemini OpenAI 호환 API. 실제 키는 Git에 올리지 말고 실행 환경에만 설정합니다.
LLM_ENABLED=false
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2

# Java 백엔드가 로컬 FastAPI Chroma 검색 서버를 호출합니다.
RAG_ENABLED=false
RAG_SEARCH_URL=http://localhost:8000
RAG_TIMEOUT_MS=5000
RAG_OFFICIAL_RESULTS=3
RAG_DIALOGUE_RESULTS=2
RAG_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
